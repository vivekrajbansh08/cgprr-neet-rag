# Copy to .env and fill in. .env is gitignored.

# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=neet
POSTGRES_HOST=localhost
# Set to 5433 if a local Postgres already uses 5432.
POSTGRES_HOST_PORT=5432

# Application roles (created by db/migrations/002_roles.sql)
NEET_INGEST_PASSWORD=change-me
NEET_READER_PASSWORD=change-me

# LLM: any OpenAI-compatible endpoint. No cloud LLM on the main path.
# Ollama on the Mac: http://localhost:11434/v1   vLLM: http://<gpu-host>:8000/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=bge-m3
EMBED_DIM=1024
