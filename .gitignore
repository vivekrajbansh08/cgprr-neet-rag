# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Secrets
.env
.env.*
!.env.example

# Data: raw MCC PDFs, row-level data and anything derived from them are never committed
# (MCC copyright: rebuild locally with scripts/fetch_sources.sh + ingest; project rule d)
data/raw/*
!data/raw/.gitkeep
!data/raw/MANIFEST.md
data/derived/*
!data/derived/.gitkeep
!data/derived/README.md
*.pdf
!docs/design_note.pdf
*.parquet
*.sqlite
*.dump

# Logs and run output
logs/*
!logs/.gitkeep

# OS / editors
.DS_Store
.idea/
.vscode/

# Local marker for the locked golden set (see eval/golden/README.md)
eval/golden/.locked

# Raw eval runs (answers contain MCC figures; only score_table.md is committed)
eval/results/runs/

# Web UI build output and self-check screenshots (screenshots show MCC figures; never committed)
services/web/node_modules/
services/web/dist/
services/web/test-results/
services/web/playwright-report/
docs/screenshots/

# Bench runs (timings + environment only; kept local)
eval/results/bench/
