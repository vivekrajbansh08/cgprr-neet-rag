# Data: raw MCC PDFs and any row-level data are never committed
data/raw/*
!data/raw/.gitkeep
!data/raw/MANIFEST.md
*.pdf
*.parquet
*.sqlite
*.dump

# Logs and run output
logs/*
!logs/.gitkeep

# OS / editors
.DS_Store
.idea/
.vscode/
